# Origin công khai của stu-api (không có dấu "/" cuối). Server Components và route
# handler gọi NestJS qua `${API_URL}/api`; URL này được dẫn xuất, không phải biến riêng.
API_URL="http://localhost:4000"

# Google Identity Services chạy trong trình duyệt nên cần client ID công khai (không
# phải secret). Đặt cùng giá trị với GOOGLE_CLIENT_ID của stu-api.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

AUTH_ACCESS_COOKIE_NAME="stu_access_token"
AUTH_REFRESH_COOKIE_NAME="stu_refresh_token"
AUTH_COOKIE_SAME_SITE="lax"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_PATH="/"
# Để trống trên localhost. Chỉ đặt khi cookie phải dùng chung một domain cha.
AUTH_COOKIE_DOMAIN=""

# Chỉ dùng khi proxy không cung cấp header quốc gia (ví dụ local dev).
DEFAULT_VISITOR_COUNTRY="VN"

# Số lớp reverse proxy đáng tin cậy trước Web. Localhost dùng 0.
TRUST_PROXY_HOPS="0"
# Header IP do reverse proxy ngoài cùng ghi đè, ví dụ cf-connecting-ip.
CLIENT_IP_HEADER=""

# Shared secret giữa stu-web và stu-api (bắt buộc, tối thiểu 32 ký tự, cùng giá
# trị với stu-api) để xác thực header x-visitor-ip / x-visitor-country.
INTERNAL_API_SECRET=""

# Thư mục bền vững do stu-web quản lý cho favicon/touch/PWA icons. Production
# một instance nên mount volume vào đây; nhiều instance phải dùng chung volume.
SITE_ICON_DIR="var/site-icons"

# Quan sát phía Web. Để trống DSN là tắt Sentry ở local.
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_APP_ENV="development"
NEXT_PUBLIC_APP_RELEASE=""

# Chỉ cần khi upload source map lên Sentry; local có thể để trống.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
